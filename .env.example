# Firebase web app config for Google sign-in. Copy to .env for local builds; the GitHub Pages
# build reads these keys from the repo's Actions Variables. Sign-in stays hidden while any is blank.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Unused for now: Analytics is not enabled.
VITE_FIREBASE_MEASUREMENT_ID=
